# Application Environment
NODE_ENV=development

# Production Canonical URL for SEO, OpenGraph and Sitemaps
VITE_SITE_URL=https://envopeace.vercel.app

# Comma-separated list of allowed administrator Google email addresses
# Example: admin@envopeace.org,director@envopeace.org
ADMIN_EMAILS=

# Firebase Client SDK Configuration (public client-side keys for Google Auth popup)
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin Service Account JSON string for server-side operations
# Generate private key in Firebase Console -> Project Settings -> Service accounts
FIREBASE_SERVICE_ACCOUNT=

# Optional Server-Side Storage Bucket override (defaults to VITE_FIREBASE_STORAGE_BUCKET or project default)
FIREBASE_STORAGE_BUCKET=

# Resend API Configuration for Notifications and Security Alerts
# Get your API key at https://resend.com
RESEND_API_KEY=

# Inquiries Recipient Email (defaults to hello@envopeace.org if unset)
CONTACT_TO_EMAIL=hello@envopeace.org
